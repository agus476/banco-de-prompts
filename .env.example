# PostgreSQL de la aplicación. Reemplazá estos valores de ejemplo.
# Si usás Supabase, copiá las cadenas de conexión desde el panel de tu proyecto.
DATABASE_URL="postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/banco_de_prompts?schema=public"

# Conexión directa usada por Prisma para administrar el esquema.
# En PostgreSQL local puede coincidir con DATABASE_URL.
DIRECT_URL="postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/banco_de_prompts?schema=public"

# Supabase Auth: necesarios para iniciar sesión en la app web.
NEXT_PUBLIC_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_CLAVE_ANON_PUBLICA"

# Obligatorio para GET/POST /api/import, incluso en localhost.
# Generá un secreto aleatorio y guardá el mismo valor desde la extensión.
# Ejemplo de generación: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IMPORT_TOKEN="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO"
